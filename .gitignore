# =============================================================================
#   QUANT AI DASHBOARD - .gitignore
# =============================================================================
#   ASLA commit edilmemeli:
#   - Sirlar (telegram token, API keys, parolalar)
#   - Otomatik uretilen buyuk dosyalar (venv, dist, APK, build cache)
#   - Kisisel cache / log dosyalari
# =============================================================================

# ---- SIRLAR (KRITIK) -------------------------------------------------------
.env
.env.*
*.key
*.pem
*.keystore
telegram_config.json
**/credentials.json
**/secrets.json
signing-key-info.txt
signing.keystore

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Sanal ortamlar --------------------------------------------------------
venv/
.venv/
env/
ENV/

# ---- PyInstaller / EXE build -----------------------------------------------
build/
dist/
*.spec.bak
*.exe
!setup.exe.example

# ---- APK / mobile build ----------------------------------------------------
*.apk
*.aab
QuantAI_APK_*/
QuantAI_PERMANENT_*.zip

# ---- Cloudflare / Tailscale tools (binaries) -------------------------------
tools/cloudflared.exe
tools/tailscale-setup.msi
tools/git-installer.exe
tools/gh-installer.msi
tools/*.log
tools/*.crt
tools/android-sdk/
tools/cmdline-tools.zip
tools/jdk*.msi
tools/node*.msi

# ---- Android / WebView build (large) ---------------------------------------
webview_apk/.gradle/
webview_apk/build/
webview_apk/app/build/
apk_build/
_bubblewrap_build.py
_build_webview_apk.py
_download_apk_toolchain.py
_fix_bw_config.py

# ---- Alpha Engine runtime (local state) ------------------------------------
alpha_engine/data/logs/
alpha_engine/data/state/*.json
alpha_engine/data/state/*.jsonl
!alpha_engine/data/state/.gitkeep

# ---- Deploy secrets --------------------------------------------------------
deploy/server_config.ini

# ---- Temp / scratch scripts ------------------------------------------------
_test_*.py
_check_*.py

# ---- Log dosyalari ---------------------------------------------------------
*.log
alerts.log
_build.log
_streamlit.log
_streamlit.err.log
launcher.log

# ---- Streamlit cache -------------------------------------------------------
.streamlit/secrets.toml

# ---- ML model cache --------------------------------------------------------
*.pkl
*.joblib
models/
ml_cache/

# ---- yfinance / data cache -------------------------------------------------
data/cache/
data/*.csv
*.pkl.tmp

# ---- QA / smoke test ciktilari --------------------------------------------
_qa_ground_truth_report.json

# ---- IDE / OS --------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Sertifika dosyalari (tailscale) --------------------------------------
*.tail*.ts.net.crt
*.tail*.ts.net.key
