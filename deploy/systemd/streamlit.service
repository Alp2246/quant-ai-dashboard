[Unit]
Description=QuantAI Dashboard (Streamlit)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment="PATH=__VENV_DIR__/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="STREAMLIT_SERVER_HEADLESS=true"
Environment="STREAMLIT_BROWSER_GATHER_USAGE_STATS=false"
Environment="HOME=__PROJECT_DIR__"
Environment="XDG_CACHE_HOME=__PROJECT_DIR__/.cache"
Environment="NLTK_DATA=__PROJECT_DIR__/.cache/nltk_data"
ExecStart=__VENV_DIR__/bin/streamlit run __PROJECT_DIR__/app.py \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false \
    --browser.serverAddress=abozer-1.tail4ea368.ts.net \
    --browser.serverPort=443
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits (Oracle ARM A1 - 12GB RAM tahsisi)
MemoryMax=6G
CPUQuota=200%

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__PROJECT_DIR__

[Install]
WantedBy=multi-user.target
