[Unit]
Description=QuantAI Dashboard (Streamlit)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quant-dashboard
Environment="PATH=/home/ubuntu/quant-dashboard/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="STREAMLIT_SERVER_HEADLESS=true"
Environment="STREAMLIT_BROWSER_GATHER_USAGE_STATS=false"
Environment="HOME=/home/ubuntu/quant-dashboard"
Environment="XDG_CACHE_HOME=/home/ubuntu/quant-dashboard/.cache"
Environment="NLTK_DATA=/home/ubuntu/quant-dashboard/.cache/nltk_data"
ExecStart=/home/ubuntu/quant-dashboard/venv/bin/streamlit run /home/ubuntu/quant-dashboard/app_lite.py \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableCORS=false \
    --server.enableXsrfProtection=false \
    --browser.serverAddress=abozer-1.tail4ea368.ts.net \
    --browser.serverPort=443
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

MemoryMax=6G
CPUQuota=200%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/quant-dashboard

[Install]
WantedBy=multi-user.target
