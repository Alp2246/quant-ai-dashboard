[Unit]
Description=QuantAI Alpha Engine (Early Warning System)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__/alpha_engine
Environment="PATH=__VENV_DIR__/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=__VENV_DIR__/bin/python __PROJECT_DIR__/alpha_engine/main.py --tick 60
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=2G
CPUQuota=100%

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__PROJECT_DIR__

[Install]
WantedBy=multi-user.target
